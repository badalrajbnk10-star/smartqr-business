# SMARTQR BUSINESS - ENVIRONMENT CONFIGURATION TEMPLATE

# Public App Config
VITE_APP_NAME="SmartQR Business"
VITE_APP_URL="http://localhost:5173"
VITE_CURRENCY="INR"
VITE_TRIAL_DURATION_HOURS="24"

# Supabase (Replace with your actual Supabase project credentials)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# Server-Side Supabase (Do NOT expose to client)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Razorpay Payment & Subscription Gateway
VITE_RAZORPAY_KEY_ID="rzp_test_YourTestKey"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# Default Super Admin Seed Email (Used for first-time admin setup)
SUPER_ADMIN_SEED_EMAIL="admin@smartqr.in"
SUPER_ADMIN_SEED_PASSWORD="ChangeThisPassword123!"
